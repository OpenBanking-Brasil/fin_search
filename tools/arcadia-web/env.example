# ARCÁDIA OS — variáveis de ambiente
#
# 1) Copie para .env na mesma pasta (tools/arcadia-web):
#    copy env.example .env
#
# 2) Supabase: Dashboard → Settings → API
#    - Project URL     → VITE_SUPABASE_URL
#    - anon public key → VITE_SUPABASE_PUBLISHABLE_KEY
#
# 3) Google Gemini (servidor — NÃO use prefixo VITE_; a chave não vai para o browser)
#    Obtenha em: https://aistudio.google.com/apikey
ARCADIA_GEMINI_API_KEY=
# Opcional: alias aceite pelo código
# GEMINI_API_KEY=

VITE_SUPABASE_URL=https://COLOCA_AQUI_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=COLOCA_AQUI_A_CHAVE_anon_public

# Opcional:
# VITE_SUPABASE_ANON_KEY=

# Auth (Magic Link localhost): Authentication → URL Configuration
#    Site URL: http://127.0.0.1:5199
#    Redirect URLs: http://127.0.0.1:5199/**  e  http://localhost:5199/**

# Opcional — ingestão API de movimentos (POST /api/finance/ingest), só no servidor:
# SUPABASE_SERVICE_ROLE_KEY=eyJ...   (Supabase → Settings → API → service_role; NUNCA expor no cliente)
# ARCADIA_FINANCE_INGEST_SECRET=um-segredo-longo-aleatório
# SUPABASE_URL=https://xxx.supabase.co
